<Window x:Class="ArgEditor.Windows.CheckVersionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Check For Updates" Height="200" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        >
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10,20,10,10">
            <Label HorizontalAlignment="Center" x:Name="CurrentVersion">Current version: {0}</Label>
            <Label HorizontalAlignment="Center" x:Name="LatestVersion">Latest version: {0}</Label>
            <Label HorizontalAlignment="Center" x:Name="DownloadLink"
                   Cursor="Hand"
                   MouseLeftButtonDown="DownloadLink_OnMouseLeftButtonDown" Foreground="CornflowerBlue" Visibility="Hidden">Download Latest Version</Label>
            <Button VerticalAlignment="Bottom" Margin="80,25,80,5" Height="25" IsCancel="True">OK</Button>
        </StackPanel>
    </Grid>
</Window>
