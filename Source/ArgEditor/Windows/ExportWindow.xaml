<Window x:Class="ArgEditor.Windows.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgEditor.Windows"
        xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
        xmlns:draw="clr-namespace:System.Drawing;assembly=System.Drawing"
        xmlns:ext="clr-namespace:ArgEditor"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:ExportViewModel, IsDesignTimeCreatable=True}"
        d:DesignWidth="364" d:DesignHeight="508"
        Title="Export" Height="508" Width="364"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Horizontal" ZIndex="0" Margin="250,-230,0,0">
            <Button Width="38" Height="25" Margin="3" Click="CarSetCheckAllButton_Click">All</Button>
            <Button Width="38" Height="25" Margin="3" Click="CarSetCheckNoneButton_Click">None</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" ZIndex="0" Margin="250,100,0,0">
            <Button Width="38" Height="25" Margin="3" Click="GameSettingsCheckAllButton_Click">All</Button>
            <Button Width="38" Height="25" Margin="3" Click="GameSettingsCheckNoneButton_Click">None</Button>
        </StackPanel>

        <StackPanel Orientation="Vertical">
            <!--<Label>Choose what to import</Label>-->
            <GroupBox Header="F1GP File" Padding="3,3,3,3" Margin="3">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="248" Margin="2,2,2,2" Text="{Binding SelectedExeFilePath}"></TextBox>
                        <Button Width="62" Margin="5,2,2,2" Click="BrowseExeFile_Click">Browse...</Button>
                    </StackPanel>
                    <Label Margin="0,0,0,-4" Height="26" Content="{Binding FileVersionMessage}"></Label>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Car Set" Padding="3,3,3,3" Margin="3">
                <StackPanel Orientation="Vertical">
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyCarColors}">Car Colors</CheckBox>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyTeamHorsepower}">Team Horsepower Values</CheckBox>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyPitCrewColors}">Pit Crew Colors</CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="2" Width="120" HorizontalAlignment="Left" IsChecked="{Binding ApplyDriverNumbers}">Driver Numbers</CheckBox>
                        <Image Visibility="{Binding ShowDriverNumbersWarning}" Source="{ext:ImageSourceFromIcon {x:Static draw:SystemIcons.Error}}" Width="14" Height="14">
                            <Image.ToolTip>
                                <ToolTip Content="{Binding ShowDriverNumbersWarningMessage}"></ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyDriverPerformanceValues}">Driver Performance Values</CheckBox>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyHelmetColors}">Helmet Colors</CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="2" Width="100" HorizontalAlignment="Left" IsChecked="{Binding ApplyPointsSystem}">Points System</CheckBox>
                        <Image Visibility="{Binding ShowPointsSystemWarning}" Source="{ext:ImageSourceFromIcon {x:Static draw:SystemIcons.Warning}}" Width="14" Height="14">
                            <Image.ToolTip>
                                <ToolTip Content="{Binding ShowPointsSystemWarningMessage}"></ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Game Settings" Padding="3,3,3,3">
                <StackPanel Orientation="Vertical">
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyPlayerHorsepowerValue}">Player Horsepower Value</CheckBox>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyGeneralAIGrip}">General AI Grip Level</CheckBox>
                    <CheckBox Margin="2" Width="200" HorizontalAlignment="Left" IsChecked="{Binding ApplyWeatherSettings}">Weather Settings</CheckBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Name File" Padding="3" Margin="3">
                <StackPanel Orientation="Vertical">
                    <CheckBox Margin="2" IsChecked="{Binding ApplyNameFile}">Name File</CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="248" Margin="2,2,2,2" Text="{Binding SelectedNameFilePath}"></TextBox>
                        <Button Width="62" Margin="5,2,2,2" Click="BrowseNameFile_Click">Browse...</Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="2" Width="210" HorizontalAlignment="Left" IsChecked="{Binding AutoLoadNameFile}">Load Name file when game starts</CheckBox>
                        <Image Visibility="{Binding ShowAutoLoadNameFileWarning}" Source="{ext:ImageSourceFromIcon {x:Static draw:SystemIcons.Error}}" Width="14" Height="14">
                            <Image.ToolTip>
                                <ToolTip Content="{Binding ShowAutoLoadNameFileWarningMessage}"></ToolTip>
                            </Image.ToolTip>
                        </Image>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                <Button Width="76" Height="23" Margin="3" IsEnabled="{Binding CanExport}" Click="ExportButton_Click">Export</Button>
                <Button Width="76" Height="23" Margin="3" IsCancel="True">Cancel</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
