    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCarSetCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCarSetCommand}" CommandParameter="{Binding}"></KeyBinding>
        <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding SaveLegacyCarSetCommand}" CommandParameter="{Binding}"></KeyBinding>
