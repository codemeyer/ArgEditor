<Window x:Class="ArgEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:userControls="clr-namespace:ArgEditor.UserControls"
        Title="ArgEditor" Height="770" Width="1025"
        WindowStartupLocation="Manual" Left="150" Top="50" ResizeMode="CanMinimize">

    <Grid Margin="5">
        <Menu HorizontalAlignment="Left" VerticalAlignment="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="FileOpenMenuItem_Click"></MenuItem>
                <MenuItem Header="_Save" Click="FileSaveMenuItem_Click"></MenuItem>
                <Separator></Separator>
                <MenuItem Header="Import">
                    <MenuItem Header="From GP.EXE" Click="FileImportFromGpExeMenuItem_Click"></MenuItem>
                    <MenuItem Header="From Names File" Click="FileImportFromNamesFileMenuItem_Click"></MenuItem>
                </MenuItem>
                <MenuItem Header="Export">
                    <MenuItem Header="To GP.EXE" Click="FileExportToGpExeMenuItem_Click"></MenuItem>
                </MenuItem>
                <Separator></Separator>
                <MenuItem Header="E_xit" Click="FileExitMenuItem_Click"></MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About ArgEditor" Click="HelpAboutMenuItem_Click"></MenuItem>
            </MenuItem>
        </Menu>

        <TabControl Margin="0,25,0,0">
            <TabItem Header="Drivers and Teams">
                <userControls:TeamDriverNamesTabUserControl x:Name="TeamsAndDriversTab"></userControls:TeamDriverNamesTabUserControl>
            </TabItem>
            <TabItem Header="Performance">
                <userControls:TeamDriverPerformanceTabUserControl x:Name="PerformanceTab"></userControls:TeamDriverPerformanceTabUserControl>
            </TabItem>
            <TabItem Header="Cars">
                <userControls:CarPaintingTabUserControl x:Name="CarPaintingTab"></userControls:CarPaintingTabUserControl>
            </TabItem>
            <TabItem Header="Helmets">
                <userControls:HelmetPaintingTabUserControl x:Name="HelmetPaintingTab"></userControls:HelmetPaintingTabUserControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
