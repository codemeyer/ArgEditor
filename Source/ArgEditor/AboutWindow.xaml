<Window x:Class="ArgEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About" Height="290" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        >
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10,10,10,10">
            <Label HorizontalAlignment="Center" Margin="0,0,0,10">ArgEditor</Label>
            <Label HorizontalAlignment="Center">Copyright © 2014-2017 Fredrik Meyer</Label>
            <Label HorizontalAlignment="Center" x:Name="VersionLabel">Version 1.0.0</Label>
            <TextBlock HorizontalAlignment="Center">
                <Hyperlink x:Name="SiteLink" Click="SiteLink_OnClick">www.manicomio.se/argeditor</Hyperlink>
            </TextBlock>
            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                <Label HorizontalAlignment="Center">Credits</Label>
                <Label HorizontalAlignment="Center" Margin="0,-10,0,-5">
                    Steve Smith, Trevor Kellaway,
                </Label>
                <Label HorizontalAlignment="Center" Margin="0,-5,0,-5">
                    Steven Young, Paul Hoad,
                </Label>
                <Label HorizontalAlignment="Center" Margin="0,-5,0,-5">
                    Hrvoje Štimac, Barrie Millar
                </Label>
            </StackPanel>
            <Button VerticalAlignment="Bottom" Margin="80,20,80,5" Height="25" Click="Button_Click">OK</Button>
        </StackPanel>
    </Grid>
</Window>
