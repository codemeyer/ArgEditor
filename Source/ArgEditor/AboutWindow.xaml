<Window x:Class="ArgEditor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgEditor"
        mc:Ignorable="d"
        Title="About" Height="200" Width="300"
        Icon="Resources/argeditor.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        >
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10,10,10,10">
            <Label HorizontalAlignment="Center" Margin="0,0,0,10">ArgEditor</Label>
            <Label HorizontalAlignment="Center">Copyright © 2014-2015 Fredrik Meyer</Label>
            <Label HorizontalAlignment="Center" x:Name="VersionLabel">Version 1.0.0</Label>
            <Button VerticalAlignment="Bottom" Margin="80,25,80,5" Height="25" Click="Button_Click">OK</Button>
        </StackPanel>
    </Grid>
</Window>
