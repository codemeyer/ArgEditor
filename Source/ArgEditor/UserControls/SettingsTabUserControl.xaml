<UserControl x:Class="ArgEditor.UserControls.SettingsTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:settingsUserControls="clr-namespace:ArgEditor.UserControls.Settings"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="740" d:DesignWidth="800">
    <Grid>
        <StackPanel VerticalAlignment="Top">
            <userControls:PlayerHorsepowerUserControl></userControls:PlayerHorsepowerUserControl>
            <userControls:GeneralGripLevelUserControl></userControls:GeneralGripLevelUserControl>
            <settingsUserControls:RainProbabilityUserControl></settingsUserControls:RainProbabilityUserControl>
            <settingsUserControls:RainAtFirstTrackUserControl></settingsUserControls:RainAtFirstTrackUserControl>
        </StackPanel>
    </Grid>
</UserControl>
