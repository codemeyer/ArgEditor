<UserControl x:Class="ArgEditor.UserControls.SettingsTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls.Settings"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="740" d:DesignWidth="800">
    <Grid Width="460" HorizontalAlignment="Left">
        <StackPanel VerticalAlignment="Top">
            <userControls:PlayerHorsepowerUserControl Margin="5,5,5,5"></userControls:PlayerHorsepowerUserControl>
            <userControls:GeneralGripLevelUserControl Margin="5,5,5,5"></userControls:GeneralGripLevelUserControl>
            <userControls:WeatherSettingsUserControl Margin="5,5,5,5"></userControls:WeatherSettingsUserControl>
            <userControls:DamageSettingsUserControl DataContext="{Binding DamageSettings}" Margin="5,5,5,5"></userControls:DamageSettingsUserControl>
        </StackPanel>
    </Grid>
</UserControl>
