                <Button Width="70" Height="24" Margin="3,0,0,0"
                                  Command="{Binding DisplayImportWizardCommand}" CommandParameter="{Binding}">
                    Import...
                </Button>
                <Button Width="70" Height="24" Margin="3,0,0,0"
                                  Command="{Binding DisplayExportWizardCommand}" CommandParameter="{Binding}">
                    Export...
                </Button>
            </StackPanel>

