<UserControl x:Class="ArgEditor.UserControls.CarSelectionItemUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="65" d:DesignWidth="140">
    <Grid Width="140" Height="65">
        <Border BorderThickness="0.5" BorderBrush="DarkGray"></Border>
        <userControls:CarUserControl Margin="3,3,3,3" HorizontalAlignment="Left" VerticalAlignment="Top" Width="134" Height="48" DataContext="{Binding Car}" />
        <Label Width="140" Height="26" Margin="0,0,0,0" HorizontalContentAlignment="Right" VerticalAlignment="Bottom" Content="{Binding Name}" />
    </Grid>
</UserControl>
