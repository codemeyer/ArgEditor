<UserControl x:Class="ArgEditor.UserControls.CarSelectionItemUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="65" d:DesignWidth="140">
    <Grid Width="135" Height="63" DataContext="{Binding}">
        <Border BorderThickness="0.5">
            <Border.Style>
                <Style>
                    <Setter Property="Border.BorderBrush" Value="DarkGray" />
                    <Setter Property="Border.BorderThickness" Value="0.5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Border.BorderBrush" Value="#404040" />
                            <Setter Property="Border.BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <userControls:CarUserControl Margin="3,3,3,3" HorizontalAlignment="Left" VerticalAlignment="Top" Width="130" Height="46" DataContext="{Binding Car}">
            <userControls:CarUserControl.Style>
                <Style TargetType="{x:Type userControls:CarUserControl}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </userControls:CarUserControl.Style>
        </userControls:CarUserControl>
        <Label Width="132" Height="26" Margin="0,0,0,0" HorizontalContentAlignment="Right" VerticalAlignment="Bottom" Content="{Binding Name}" />
    </Grid>
</UserControl>

