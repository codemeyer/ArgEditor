<UserControl x:Class="ArgEditor.UserControls.PaletteUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:argEditor="clr-namespace:ArgEditor"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <argEditor:ColorConverter x:Key="ColorConverter" />
    </UserControl.Resources>
    <Grid>
        <WrapPanel x:Name="PaletteContainer" Width="320" Height="320" Margin="0,0,0,80">
        </WrapPanel>
        <Rectangle HorizontalAlignment="Left" Height="25" Margin="178,365,0,0" VerticalAlignment="Top" Width="100"
                   Stroke="Black" Fill="{Binding SelectedColor, Converter={StaticResource ColorConverter}}" />
    </Grid>
</UserControl>
