<UserControl x:Class="ArgEditor.UserControls.PaletteUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:argEditor="clr-namespace:ArgEditor"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             xmlns:converters="clr-namespace:ArgEditor.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:PaletteViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="380" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:ColorConverter x:Key="ColorConverter" />

        <Style x:Key="ColorRectangleStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="0.1"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="Red"/>
                    <Setter Property="StrokeThickness" Value="1.2"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="71" Margin="0,0,5,5"
                             Click="PaletteToolFill_Click"
                             IsChecked="{Binding IsPaletteToolFill}">Fill</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="71" Margin="0,0,5,5"
                             Click="PaletteToolPickup_Click"
                             IsChecked="{Binding IsPaletteToolPickup}">Pickup</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="71" Margin="0,0,5,5"
                             Click="PaletteToolDarker_Click"
                             IsChecked="{Binding IsPaletteToolDarker}">Darken</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="71" Margin="0,0,0,5"
                             Click="PaletteToolBrighter_Click"
                             IsChecked="{Binding IsPaletteToolBrighter}">Brighten</RadioButton>
            </StackPanel>
        <ItemsControl ItemsSource="{Binding Colors}" Width="320" Height="320" x:Name="PaletteContainer">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Fill="{Binding ColorIndex, Converter={StaticResource ColorConverter}}" Width="20" Height="20"
                               Style="{StaticResource ColorRectangleStyle}">
                        <Rectangle.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding SelectPaletteColorCommand}" CommandParameter="{Binding}"></MouseBinding>
                        </Rectangle.InputBindings>
                    </Rectangle>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Rectangle HorizontalAlignment="Left" Height="25" Margin="200,10,0,0" VerticalAlignment="Top" Width="120"
                   Stroke="Black" Fill="{Binding SelectedColor, Converter={StaticResource ColorConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
