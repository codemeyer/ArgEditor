<UserControl x:Class="ArgEditor.UserControls.CarPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">
    <Grid>
        <userControls:CarSelectionUserControl></userControls:CarSelectionUserControl>
        <userControls:CarUserControl DataContext="{Binding SelectedTeam.Car}" Width="497" Margin="382,10,21,611" Height="179"></userControls:CarUserControl>
        <userControls:PitCrewUserControl DataContext="{Binding SelectedTeam.PitCrew}" Margin="719,223,21,310"></userControls:PitCrewUserControl>
    </Grid>
</UserControl>
