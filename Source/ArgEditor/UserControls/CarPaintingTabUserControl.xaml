<UserControl x:Class="ArgEditor.UserControls.CarPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="600" d:DesignWidth="920">
    <Grid KeyDown="CarPaintingTab_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <userControls:CarSelectionListUserControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                  SelectedTeamUpdated="CarSelectionUserControl_OnSelectedTeamUpdated" HorizontalAlignment="Left"
                                                  Height="689" Margin="10" VerticalAlignment="Top" />
        <userControls:CarUserControl Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="10"
                                     BorderBrush="#D4D4D4" BorderThickness="1"
                                     DataContext="{Binding SelectedTeam.Car}" x:Name="PaintCarUserControl" IsEditable="true" ClickedPolygon="PaintCarUserControl_OnClickedPolygon"></userControls:CarUserControl>
        <Label Grid.Column="1" Grid.Row="0" Content="{Binding SelectedTeam.Name}"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />
        <userControls:PitCrewUserControl Grid.Column="1" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         BorderBrush="#D4D4D4" BorderThickness="1"
                                         DataContext="{Binding SelectedTeam.PitCrew}" Margin="10,20,10,10"
                                         ClickedPitCrewPolygon="PaintPitCrewUserControl_OnClickedPolygon"></userControls:PitCrewUserControl>
        <userControls:PaletteUserControl Grid.Column="2" Grid.Row="1" Margin="10,10,10,10"
                                         DataContext="{Binding Palette}" HorizontalAlignment="Right" VerticalAlignment="Top" />
    </Grid>
</UserControl>
