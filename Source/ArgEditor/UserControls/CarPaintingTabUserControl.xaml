<UserControl x:Class="ArgEditor.UserControls.CarPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="740" d:DesignWidth="1000">
    <Grid KeyDown="CarPaintingTab_KeyDown">
        <userControls:CarSelectionListUserControl SelectedTeamUpdated="CarSelectionUserControl_OnSelectedTeamUpdated" HorizontalAlignment="Left" Height="689" Margin="10,10,0,0" VerticalAlignment="Top" Width="362"/>
        <userControls:CarUserControl DataContext="{Binding SelectedTeam.Car}"  Margin="379,10,10,439"  x:Name="PaintCarUserControl" IsEditable="true" ClickedPolygon="PaintCarUserControl_OnClickedPolygon"></userControls:CarUserControl>
        <userControls:PitCrewUserControl DataContext="{Binding SelectedTeam.PitCrew}" Margin="290,262,352,87" ClickedPitCrewPolygon="PaintPitCrewUserControl_OnClickedPolygon"></userControls:PitCrewUserControl>
        <userControls:PaletteUserControl DataContext="{Binding Palette}" HorizontalAlignment="Left" Margin="586,282,0,0" VerticalAlignment="Top" Height="327"/>
    </Grid>
</UserControl>
