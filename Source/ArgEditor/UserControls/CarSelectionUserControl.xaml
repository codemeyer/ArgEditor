            <Label Width="140" Height="25" Content="{Binding Teams[2].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[3].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[4].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[5].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[4].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[5].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[6].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[7].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[6].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[7].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[8].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[9].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[8].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[9].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[10].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[11].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[10].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[11].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[12].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[13].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[12].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[13].Name}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[14].Car}" />
            <userControls:CarUserControl Margin="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="140" Height="60" DataContext="{Binding Teams[15].Car}" />
            <Label Width="140" Height="25" Content="{Binding Teams[14].Name}" />
            <Label Width="140" Height="25" Content="{Binding Teams[15].Name}" />
