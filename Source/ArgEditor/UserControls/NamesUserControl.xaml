<UserControl x:Class="ArgEditor.UserControls.TeamDriverNamesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:TeamViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="2,4,2,4">
        <userControls:CarUserControl HorizontalAlignment="Left" VerticalAlignment="Top" Width="54" Height="23" DataContext="{Binding Car}" Margin="3,0,0,0" />

        <TextBox HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" Text="{Binding Name}" VerticalAlignment="Top" Width="120" Margin="67,0,0,0" MaxLength="12" />
        <TextBox HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" Text="{Binding Engine}" Visibility="{Binding Visibility}" VerticalAlignment="Top" Width="120" Margin="192,0,0,0" MaxLength="12" />
        <ComboBox HorizontalAlignment="Left" Margin="331,0,0,0" VerticalAlignment="Top" ItemsSource="{Binding AvailableDriverNumbers}" SelectedItem="{Binding Drivers[0].Number}" IsEnabled="{Binding Drivers[0].Enabled}" Width="44" Height="23" />
        <TextBox HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" Text="{Binding Drivers[0].Name}" VerticalAlignment="Top" Width="160" Margin="380,0,0,0" MaxLength="23" />
        <ComboBox HorizontalAlignment="Left" Margin="552,0,0,0" VerticalAlignment="Top" ItemsSource="{Binding AvailableDriverNumbers}" SelectedItem="{Binding Drivers[1].Number}" IsEnabled="{Binding Drivers[1].Enabled}" Width="44" Height="23" />
        <TextBox HorizontalAlignment="Left" Height="23" TextWrapping="Wrap" Text="{Binding Drivers[1].Name}" VerticalAlignment="Top" Width="160" Margin="601,0,0,0" MaxLength="23" />
    </Grid>
</UserControl>
