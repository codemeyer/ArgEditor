<UserControl x:Class="ArgEditor.UserControls.TeamDriverNamesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:TeamViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="2,4,2,4">
        <TextBox HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" Text="{Binding Name}" VerticalAlignment="Top" Width="120" Margin="3,0,0,0" MaxLength="12" />
        <TextBox HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" Text="{Binding Engine}" VerticalAlignment="Top" Width="120" Margin="128,0,0,0" MaxLength="12" />
        <TextBox HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" Text="{Binding Drivers[0].Name}" VerticalAlignment="Top" Width="160" Margin="268,0,0,0" MaxLength="23" />
        <ComboBox HorizontalAlignment="Left" Margin="433,0,0,0" VerticalAlignment="Top" ItemsSource="{Binding AvailableDriverNumbers}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding Drivers[0].Number, ValidatesOnDataErrors=true, NotifyOnValidationError=true}" Width="44" Height="22" IsTabStop="True" />
        <Border Height="22" HorizontalAlignment="Left" Margin="478,0,0,0">
            <Border.Style>
                <Style>
                    <Setter Property="Border.BorderThickness" Value="0"/>
                    <Setter Property="Border.Width" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Drivers[0].HasSameNumberAsOtherDriver}" Value="True">
                            <Setter Property="Border.BorderThickness" Value="2"/>
                            <Setter Property="Border.Width" Value="2" />
                            <Setter Property="Border.BorderBrush" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <TextBox HorizontalAlignment="Left" Height="22" TextWrapping="Wrap" Text="{Binding Drivers[1].Name}" VerticalAlignment="Top" Width="160" Margin="492,0,0,0" MaxLength="23" />
        <ComboBox HorizontalAlignment="Left" Margin="657,0,0,0" VerticalAlignment="Top" ItemsSource="{Binding AvailableDriverNumbers}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value" SelectedValue="{Binding Drivers[1].Number, ValidatesOnDataErrors=true, NotifyOnValidationError=true}" Width="44" Height="22"></ComboBox>
        <Border Height="22" HorizontalAlignment="Left" Margin="702,0,0,0">
            <Border.Style>
                <Style>
                    <Setter Property="Border.BorderThickness" Value="0"/>
                    <Setter Property="Border.Width" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Drivers[1].HasSameNumberAsOtherDriver}" Value="True">
                            <Setter Property="Border.BorderThickness" Value="2"/>
                            <Setter Property="Border.Width" Value="2" />
                            <Setter Property="Border.BorderBrush" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
