<UserControl x:Class="ArgEditor.UserControls.CarUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:argEditor="clr-namespace:ArgEditor"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="780">
    <UserControl.DataContext>
        <viewModels:DesignerCarEditingViewModel />
    </UserControl.DataContext>
    <UserControl.Resources>
        <argEditor:ColorConverter x:Key="ColorConverter" />
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="780" Height="280" Opacity="{Binding Opacity}" Background="Transparent">
            <Image Source="/ArgEditor;component/Resources/right-front.png" Canvas.Left="111" Canvas.Top="97" Width="98"></Image>

            <Polygon Points="12,223 92,170 92,200" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="44,282 12,223 92,198 138,259" Stroke="Black" Fill="{Binding FrontAndRearWingColorIndex, Converter={StaticResource ColorConverter}}" Tag="FrontAndRearWingColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="24,243 230,153 332,138 30,253" Stroke="Black" Fill="{Binding NoseTopColorIndex, Converter={StaticResource ColorConverter}}" Tag="NoseTopColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="230,153 332,138 320,117" Stroke="Black" Fill="{Binding CockpitFrontColorIndex, Converter={StaticResource ColorConverter}}" Tag="CockpitTopColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="33,253 332,138 341,176" Stroke="Black" Fill="{Binding NoseAngleColorIndex, Converter={StaticResource ColorConverter}}" Tag="NoseAngleColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="33,253 341,176 437,159 437,208" Stroke="Black" Fill="{Binding NoseSideColorIndex, Converter={StaticResource ColorConverter}}" Tag="NoseSideColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="44,282 145,265 145,221" Stroke="Black" Fill="{Binding FrontWingEndplateColorIndex, Converter={StaticResource ColorConverter}}" Tag="FrontWingEndplateColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="332,138 341,176 437,159 431,130" Stroke="Black" Fill="{Binding CockpitSideColorIndex, Converter={StaticResource ColorConverter}}" Tag="CockpitSideColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="437,159 431,130 563,122 578,149" Stroke="Black" Fill="{Binding EngineCoverSideColorIndex, Converter={StaticResource ColorConverter}}" Tag="EngineCoverSideColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="431,130 418,66 410,62 473,59 569,99 563,122" Stroke="Black" Fill="{Binding EngineCoverColorIndex, Converter={StaticResource ColorConverter}}" Tag="EngineCoverColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="437,159 578,149 634,131 678,139 641,155 473,171" Stroke="Black" Fill="{Binding SidepodTopColorIndex, Converter={StaticResource ColorConverter}}" Tag="SidepodTopColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="473,171 473,226 641,202 641,155" Stroke="Black" Fill="{Binding SidepodColorIndex, Converter={StaticResource ColorConverter}}" Tag="SidepodColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="591,44 637,40 637,108 591,121" Stroke="Black" Fill="DimGray" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="563,122 578,149 634,131 569,99" Stroke="Black" Fill="{Binding EngineCoverRearColorIndex, Converter={StaticResource ColorConverter}}" Tag="EngineCoverRearColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="600,65 637,53 727,67 701,83" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="598,99 636,86 725,100 703,118" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="636,53 637,40 736,53 728,67" Stroke="Black"  Fill="{Binding FrontAndRearWingColorIndex, Converter={StaticResource ColorConverter}}" Tag="FrontAndRearWingColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="696,56 738,52 738,117 696,129" Stroke="Black"  Fill="{Binding RearWingSideColorIndex, Converter={StaticResource ColorConverter}}" Tag="RearWingSideColorIndex"
                     MouseDown="UIElement_OnMouseDown" MouseEnter="UIElement_OnMouseEnter" MouseLeave="UIElement_OnMouseLeave" Canvas.Top="-27" Canvas.Left="-4" />

            <Polygon Points="641,155 641,202 675,179 678,139" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="437,159 473,171 473,226 437,208" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />
            <Polygon Points="431,130 418,66 410,62 407,68 397,120 328,128 332,138" Stroke="Black" Fill="Black" Canvas.Top="-27" Canvas.Left="-4" />

            <Image Source="/ArgEditor;component/Resources/left-front.png" Canvas.Left="177" Canvas.Top="145" Width="137"></Image>
            <Image Source="/ArgEditor;component/Resources/left-rear.png" Canvas.Left="656" Canvas.Top="91" Width="119"></Image>
        </Canvas>
    </Viewbox>
</UserControl>
