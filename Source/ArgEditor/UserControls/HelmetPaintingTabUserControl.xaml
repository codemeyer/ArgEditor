<UserControl x:Class="ArgEditor.UserControls.HelmetPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="900" d:DesignWidth="1025">
    <Grid KeyDown="PaintingTab_KeyDown">
        <ItemsControl ItemsSource="{Binding Drivers}" Margin="10,10,565,10" x:Name="HelmetPanel">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <userControls:HelmetUserControl DataContext="{Binding Helmet}"
                                                    Width="60" Margin="20,10,20,10" Height="50"
                                                    MouseLeftButtonDown="SelectHelmet_OnMouseLeftButtonDown"></userControls:HelmetUserControl>
                        <TextBlock Text="{Binding Name}" Width="94" TextAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <userControls:HelmetUserControl DataContext="{Binding SelectedHelmet}" HorizontalAlignment="Left" Margin="633,41,0,0"
                                        VerticalAlignment="Top" Height="200" Width="200" IsEditable="true"
                                        ClickedHelmetPolygon="PaintHelmetUserControl_OnClickedPolygon" />
        <userControls:PaletteUserControl DataContext="{Binding Palette}" HorizontalAlignment="Left" Margin="583,348,0,0" VerticalAlignment="Top"/>
    </Grid>

</UserControl>
