<UserControl x:Class="ArgEditor.UserControls.HelmetPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="620" d:DesignWidth="920">
    <Grid KeyDown="PaintingTab_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Drivers}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <userControls:HelmetUserControl DataContext="{Binding Helmet}"
                                                    Width="50" Margin="10,5,10,5" Height="40"
                                                    MouseLeftButtonDown="SelectHelmet_OnMouseLeftButtonDown"></userControls:HelmetUserControl>
                        <TextBlock Text="{Binding ShortName}" Width="94" TextAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <userControls:HelmetUserControl Grid.Column="1" Grid.Row="0" DataContext="{Binding SelectedHelmet}"
                                        HorizontalAlignment="Right" Margin="0,0,70,10" VerticalAlignment="Top"
                                        Height="200" Width="200" IsEditable="true"
                                        ClickedHelmetPolygon="PaintHelmetUserControl_OnClickedPolygon" />
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="90,10,10,10"
               Content="{Binding SelectedHelmet.Parent.Name}" />
        <userControls:PaletteUserControl Grid.Column="1" Grid.Row="1" DataContext="{Binding Palette}"
                                         HorizontalAlignment="Right" Margin="10"
                                         VerticalAlignment="Top"/>
    </Grid>

</UserControl>
