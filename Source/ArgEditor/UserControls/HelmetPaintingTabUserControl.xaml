<UserControl x:Class="ArgEditor.UserControls.HelmetPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             xmlns:viewModels="clr-namespace:ArgEditor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="620" d:DesignWidth="920">
    <UserControl.InputBindings>
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding PaletteSelectNextBrighterColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding PaletteSelectNextDarkerColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
    </UserControl.InputBindings>
    <Grid KeyDown="PaintingTab_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Drivers}" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <userControls:HelmetUserControl DataContext="{Binding Helmet}"
                                                    Width="50" Margin="10,5,10,5" Height="40"
                                                    MouseLeftButtonDown="SelectHelmet_OnMouseLeftButtonDown">
                            <userControls:HelmetUserControl.Style>
                                <Style TargetType="{x:Type userControls:HelmetUserControl}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </userControls:HelmetUserControl.Style>
                            <userControls:HelmetUserControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="HelmetSelectionCopy_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    <MenuItem Header="Paste" Click="HelmetSelectionPaste_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    <Separator></Separator>
                                    <MenuItem Header="Load .HEL File" Click="HelmetSelectionLoadFile_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                </ContextMenu>
                            </userControls:HelmetUserControl.ContextMenu>
                        </userControls:HelmetUserControl>
                        <TextBlock Text="{Binding ShortName}" Width="94" TextAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <userControls:HelmetUserControl Grid.Column="1" Grid.Row="0" DataContext="{Binding SelectedHelmet}"
                                        HorizontalAlignment="Right" Margin="0,0,70,10" VerticalAlignment="Top"
                                        Height="200" Width="200" IsEditable="true"
                                        ClickedHelmetPolygon="PaintHelmetUserControl_OnClickedPolygon" />
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="90,10,10,10"
               Content="{Binding SelectedHelmet.Parent.Name}" />
        <userControls:PaletteUserControl Grid.Column="1" Grid.Row="1" DataContext="{Binding Palette}"
                                         HorizontalAlignment="Right" Margin="10"
                                         VerticalAlignment="Top"/>
        <TextBlock Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" Margin="20,-100,300,0" Visibility="{Binding SelectedHelmet.ShowDecompressedExeMessage}">
            Note: Limitations apply to helmets for drivers
            with numbers #13, #15, #36, #37, #38, #39 and #40,
            unless you are using a decompressed EXE.

            <Hyperlink
                NavigateUri="http://manicomio.se/argeditor/decompressed-exe/"
                RequestNavigate="Hyperlink_RequestNavigate">
                Learn more!
            </Hyperlink>
        </TextBlock>
    </Grid>

</UserControl>
