<UserControl x:Class="ArgEditor.UserControls.TeamDriverPerformanceTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignWidth="880" d:DesignHeight="590">
    <UserControl.Resources>
        <Style x:Key="headerStyle" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="625"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="6,0,0,0">
            <StackPanel Margin="0,0,0,-2" Orientation="Horizontal">
                <Label Margin="125,0,0,0">HP</Label>
                <Label Margin="160,0,0,0">Qual</Label>
                <Label Margin="2,0,0,0">Race</Label>
                <Label Margin="136,0,0,0">Qual</Label>
                <Label Margin="2,0,0,0">Race</Label>
            </StackPanel>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[0]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[1]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[2]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[3]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[4]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[5]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[6]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[7]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[8]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[9]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[10]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[11]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[12]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[13]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[14]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[15]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[16]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[17]}"></userControls:TeamDriverPerformanceUserControl>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Visible">
            <RadioButton GroupName="PerformanceViewRadioButtons" Name="PerformanceToggleShowQualifying" Margin="0,0,20,0" Checked="PerformanceViewToggle">
                Qual
            </RadioButton>
            <RadioButton GroupName="PerformanceViewRadioButtons" Name="PerformanceToggleShowRace" IsChecked="True" Checked="PerformanceViewToggle">
                Race
            </RadioButton>
            <ComboBox Margin="22,-3,0,0" ItemsSource="{Binding AvailableTrackTypes}" DisplayMemberPath="DisplayValue" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedTrackType}" Width="108">
            </ComboBox>
        </StackPanel>
        <ListView Grid.Column="1" Width="238" Height="544" VerticalAlignment="Top" ItemsSource="{Binding DriverPerformanceList}"
                    Background="Transparent" Margin="0,28,0,10">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource headerStyle}">
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Rank}" Width="15" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyBeingEdited}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DriverName}" Width="110">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyBeingEdited}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePerformanceText}" Width="50" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyBeingEdited}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="18" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
