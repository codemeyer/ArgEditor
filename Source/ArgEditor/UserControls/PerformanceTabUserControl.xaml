<UserControl x:Class="ArgEditor.UserControls.TeamDriverPerformanceTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ArgEditor.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="740" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="0,24,-320,0">
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[0]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[1]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[2]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[3]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[4]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[5]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[6]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[7]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[8]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[9]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[10]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[11]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[12]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[13]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[14]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[15]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[16]}"></userControls:TeamDriverPerformanceUserControl>
            <userControls:TeamDriverPerformanceUserControl DataContext="{Binding Teams[17]}"></userControls:TeamDriverPerformanceUserControl>
        </StackPanel>

        <ListView Margin="683,20,10,10" ItemsSource="{Binding DriverPerformanceList}">
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DriverName}" Width="150" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePerformanceText}" TextAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</UserControl>
