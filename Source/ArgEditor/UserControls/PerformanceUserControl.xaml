<UserControl x:Class="ArgEditor.UserControls.TeamDriverPerformanceUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:utils="clr-namespace:ArgEditor.ViewModels.Utils"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=utils:DesignerTeamViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="31" d:DesignWidth="640">
    <Grid Margin="2,4,2,4">
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="0,0,0,-4" Width="118" Content="{Binding Name}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" Height="23" Margin="117,0,0,0" Width="38" Text="{Binding Horsepower, UpdateSourceTrigger=PropertyChanged}" KeyDown="UIElement_OnKeyDown" Visibility="{Binding Visibility}"></TextBox>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="197,0,0,-4" Width="130" Content="{Binding Drivers[0].ShortName}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Margin="316,0,0,0" Width="32" Text="{Binding Drivers[0].QualifyingGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[0].Visibility}" KeyDown="UIElement_OnKeyDown"></TextBox>
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Margin="353,0,0,0" Width="32" Text="{Binding Drivers[0].RaceGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[0].Visibility}" KeyDown="UIElement_OnKeyDown"></TextBox>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="411,0,0,-4" Width="130" Content="{Binding Drivers[1].ShortName}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Margin="528,0,0,0" Width="32" Text="{Binding Drivers[1].QualifyingGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[1].Visibility}" KeyDown="UIElement_OnKeyDown"></TextBox>
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="23" Margin="565,0,0,0" Width="32" Text="{Binding Drivers[1].RaceGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[1].Visibility}" KeyDown="UIElement_OnKeyDown"></TextBox>
    </Grid>
</UserControl>
