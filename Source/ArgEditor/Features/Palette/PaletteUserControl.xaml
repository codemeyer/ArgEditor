<UserControl x:Class="ArgEditor.Features.Palette.PaletteUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:carSet="clr-namespace:ArgEditor.Features.CarSet"
             xmlns:palette="clr-namespace:ArgEditor.Features.Palette"
             xmlns:application="clr-namespace:ArgEditor.Features.Application"
             xmlns:draw="clr-namespace:System.Drawing;assembly=System.Drawing"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=palette:PaletteViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="360" d:DesignWidth="290">
    <UserControl.Resources>
        <carSet:ColorConverter x:Key="ColorConverter" />

        <Style x:Key="ColorRectangleStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="Black"/>
            <Setter Property="StrokeThickness" Value="0.1"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Stroke" Value="Red"/>
                    <Setter Property="StrokeThickness" Value="1.2"></Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Width="291">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="69" Margin="0,0,4,5"
                             Click="PaletteToolFill_Click"
                             IsChecked="{Binding IsPaletteToolFill}">Fill</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="69" Margin="0,0,4,5"
                             Click="PaletteToolPickup_Click"
                             IsChecked="{Binding IsPaletteToolPickup}">Pickup</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="69" Margin="0,0,4,5"
                             Click="PaletteToolDarker_Click"
                             IsChecked="{Binding IsPaletteToolDarker}">Darken</RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}"
                             Height="25" Width="69" Margin="0,0,0,5"
                             Click="PaletteToolBrighter_Click"
                             IsChecked="{Binding IsPaletteToolBrighter}">Brighten</RadioButton>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Colors}" HorizontalAlignment="Left" Width="290" Height="290" x:Name="PaletteContainer">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Rectangle Fill="{Binding ColorIndex, Converter={StaticResource ColorConverter}}" Width="18" Height="18"
                               Style="{StaticResource ColorRectangleStyle}">
                            <Rectangle.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding SelectPaletteColorCommand}" CommandParameter="{Binding}"></MouseBinding>
                            </Rectangle.InputBindings>
                        </Rectangle>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Margin="2">
                <TextBlock Margin="0,0,10,0">Selected Color:</TextBlock>
                <Rectangle Margin="40,0,0,0" HorizontalAlignment="Right" Height="18" VerticalAlignment="Top" Width="157"
                           Stroke="Black" Fill="{Binding SelectedColor, Converter={StaticResource ColorConverter}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="2" Visibility="{Binding ShowPaletteTrackColorWarning}">
                <Image Source="{application:ImageSourceFromIcon {x:Static draw:SystemIcons.Warning}}" Width="14" Height="14" />
                <TextBlock Margin="4,0,10,0">This color may change slightly based on the track</TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="2" Visibility="{Binding ShowPaletteWetWeatherColorWarning}">
                <Image Source="{application:ImageSourceFromIcon {x:Static draw:SystemIcons.Warning}}" Width="14" Height="14" />
                <TextBlock Margin="4,0,10,0">This color may turn gray during wet races</TextBlock>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
