<UserControl x:Class="ArgEditor.Features.Application.About.AboutTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:about="clr-namespace:ArgEditor.Features.Application.About"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=about:AboutTabViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="460" d:DesignWidth="520">
    <Grid Width="520">
        <StackPanel Orientation="Vertical">

            <!--<StackPanel Margin="5" Orientation="Horizontal">
                <Button HorizontalAlignment="Left" Width="140" Height="24" Margin="0"
                        Command="{Binding CheckForUpdateCommand}" CommandParameter="{Binding}">
                    Check for Updates
                </Button>
                <Label Visibility="{Binding VersionLatestLabel}">You are running the latest version!</Label>
                <Label Visibility="{Binding VersionUnableToRetrieveLabel}">Unable to retrieve version info!</Label>
                <TextBlock Visibility="{Binding VersionNewAvailable}">
                    <TextBlock>
                        <Label>New version available:</Label>
                        <Label Content="{Binding LatestVersion}"></Label>
                    </TextBlock>
                    <Hyperlink BaselineAlignment="Center" Command="{Binding OpenDownloadPageCommand}">Download!</Hyperlink>
                </TextBlock>
            </StackPanel>-->

            <TabControl Margin="5">
                <TabItem Header="Help/About">
                    <StackPanel Orientation="Vertical">
                        <GroupBox Margin="5" Header="About">
                            <StackPanel Orientation="Vertical">
                                <TextBlock>
                                    <Label>ArgEditor</Label>
                                    <Label Content="{Binding CurrentVersion}"></Label>
                                </TextBlock>
                                <TextBlock>
                                    <Label>Copyright © 2014-2020 Fredrik Meyer</Label>
                                </TextBlock>
                                <TextBlock Margin="5">
                                    Website: <Hyperlink Command="{Binding HelpDocsCommand}">https://www.argtools.com/argeditor/</Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="5">
                                    Community sites:
                                    <LineBreak/>
                                    <Hyperlink Command="{Binding OpenCommunityWebSiteCommand}">https://sites.google.com/view/f1gpwc/</Hyperlink>
                                    <LineBreak/>
                                    <Hyperlink Command="{Binding OpenGoogleGroupsWebSiteCommand}">https://groups.google.com/forum/#!forum/f1gpwc</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Margin="5" Header="Credits">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Margin="5" TextWrapping="Wrap">
                                    <Hyperlink Command="{Binding OpenAcknowledgementsPageCommand}">https://www.argtools.com/acknowledgements/</Hyperlink><LineBreak/>
                                    <LineBreak/>
                                    ArgEditor is powered by the <Hyperlink Command="{Binding OpenArgDataPageCommand}">ArgData API</Hyperlink><LineBreak/>
                                    <LineBreak/>
                                    Various icons made by Freepik from www.flaticon.com<LineBreak />
                                    Color comparisons are done using the ColorMine API
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </Grid>
</UserControl>
