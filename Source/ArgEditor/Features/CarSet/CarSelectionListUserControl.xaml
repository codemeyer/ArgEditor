<UserControl x:Class="ArgEditor.Features.CarSet.CarSelectionListUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:carSet="clr-namespace:ArgEditor.Features.CarSet"
             xmlns:main="clr-namespace:ArgEditor.Features.Main"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="590"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=True}">
    <Grid>
        <ItemsControl ItemsSource="{Binding Teams}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Name="CarsPanel" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <carSet:CarSelectionItemUserControl MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                        <carSet:CarSelectionItemUserControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy" Click="CarSelectionCopy_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                <MenuItem Header="Paste" Click="CarSelectionPaste_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                <Separator></Separator>
                                <MenuItem Header="Load .CAR File" Click="CarSelectionLoadCarFile_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                            </ContextMenu>
                        </carSet:CarSelectionItemUserControl.ContextMenu>
                    </carSet:CarSelectionItemUserControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
