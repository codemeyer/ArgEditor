<UserControl x:Class="ArgEditor.Features.CarSet.CarColors.CarPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:draw="clr-namespace:System.Drawing;assembly=System.Drawing"
             xmlns:carSet="clr-namespace:ArgEditor.Features.CarSet"
             xmlns:application="clr-namespace:ArgEditor.Features.Application"
             xmlns:pitCrew="clr-namespace:ArgEditor.Features.CarSet.PitCrew"
             xmlns:palette="clr-namespace:ArgEditor.Features.Palette"
             xmlns:main="clr-namespace:ArgEditor.Features.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="880" d:DesignHeight="590">
    <UserControl.InputBindings>
        <KeyBinding Key="OemPlus" Command="{Binding PaletteSelectNextBrighterColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
        <KeyBinding Key="OemMinus" Command="{Binding PaletteSelectNextDarkerColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
    </UserControl.InputBindings>
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <carSet:CarSelectionListUserControl Grid.Column="0" Grid.Row="0"
                                                  SelectedTeamUpdated="CarSelectionUserControl_OnSelectedTeamUpdated" HorizontalAlignment="Left"
                                                  Height="600" Margin="5" VerticalAlignment="Top" />

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="211" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <carSet:CarUserControl Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="5"
                                     BorderBrush="#D4D4D4" BorderThickness="1"
                                     DataContext="{Binding SelectedTeam.Car}" x:Name="PaintCarUserControl" IsEditable="true" ClickedPolygon="PaintCarUserControl_OnClickedPolygon">
            </carSet:CarUserControl>
            <Label Grid.Column="0" Grid.Row="0" Content="{Binding SelectedTeam.Name}"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" />

            <Image Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" Margin="0,160,208,0" Visibility="{Binding SelectedTeam.ShowNoActiveDriversWarning}"
                   Source="{application:ImageSourceFromIcon {x:Static draw:SystemIcons.Warning}}" Width="14" Height="14"></Image>
            <TextBlock Grid.Column="1" Grid.Row="0" Visibility="{Binding SelectedTeam.ShowNoActiveDriversWarning}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,173,15,0">
                This team has no active drivers and<LineBreak />
                the car will not appear in the game
            </TextBlock>

            <pitCrew:PitCrewUserControl Grid.Column="0" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         BorderBrush="#D4D4D4" BorderThickness="1"
                                         DataContext="{Binding SelectedTeam.PitCrew}" Margin="5,0,5,10"
                                         ClickedPitCrewPolygon="PaintPitCrewUserControl_OnClickedPolygon"></pitCrew:PitCrewUserControl>
            <palette:PaletteUserControl Grid.Column="1" Grid.Row="1" Margin="0,0,5,5"
                                         DataContext="{Binding Palette}" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</UserControl>
