<UserControl x:Class="ArgEditor.Features.CarSet.HelmetColors.HelmetUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:carSet="clr-namespace:ArgEditor.Features.CarSet"
             xmlns:helmetColors="clr-namespace:ArgEditor.Features.CarSet.HelmetColors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=helmetColors:DesignerHelmetViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="200" d:DesignHeight="166">
    <UserControl.Resources>
        <carSet:ColorConverter x:Key="ColorConverter" />
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Canvas Width="200" Height="166" Background="{Binding BackgroundColor}">
        <!-- TODO: add polygon around outer edges, so that the Stroke of all other items can be removed for the thumbnails -->

        <Polygon Points="65,15 82,8 96,4 119,4 129,6 138,9 150,15"
                 Stroke="Black" Fill="{Binding Stripe1ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="50,27 58,20 65,15 150,15 158,19 166,27"
                 Stroke="Black" Fill="{Binding Stripe2ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="40,39 46,33 50,27 166,27 173,33 177,39"
                 Stroke="Black" Fill="{Binding Stripe3ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="36,48 40,39 177,39 181,44 184,51 62,51"
                 Stroke="Black" Fill="{Binding Stripe4ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="62,51 184,51 187,57 188,63 116,63 112,60"
                 Stroke="Black" Fill="{Binding Stripe5ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="116,63 188,63 190,69 190,76 113,75 116,69"
                 Stroke="Black" Fill="{Binding Stripe6ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="107,87 113,75 190,75 191,82 190,87"
                 Stroke="Black" Fill="{Binding Stripe7ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="100,99 107,87 190,87 190,93 189,99"
                 Stroke="Black" Fill="{Binding Stripe8ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="86,111 91,108 97,104 100,99 189,99 186,111"
                 Stroke="Black" Fill="{Binding Stripe9ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="10,123 9,111 186,111 183,119 182,123"
                 Stroke="Black" Fill="{Binding Stripe10ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="13,135 12,130 10,123 182,123 177,130 175,135"
                 Stroke="Black" Fill="{Binding Stripe11ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="16,147 13,135 175,135 171,142 168,147"
                 Stroke="Black" Fill="{Binding Stripe12ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="24,159 19,154 16,147 168,147 164,153 159,159"
                 Stroke="Black" Fill="{Binding Stripe13ColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="9,111 86,111 91,108 100,99 107,87 113,75 116,69 116,63 112,60 62,51 36,48
                 34,51 90,61 97,64 100,67 103,74 103,83 98,93 91,101 85,105 74,106 12,106"
                 Stroke="Black" Fill="{Binding VisorSurroundColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        <Polygon Points="24,159 159,159 155,162 28,162"
                 Stroke="Black" Fill="Black" />

        <Polygon Points="34,51 90,61 97,64 100,67 103,74 103,83 98,93 91,101 85,105 74,106 12,106"
                 Stroke="Black" Fill="{Binding VisorColorIndex, Converter={StaticResource ColorConverter}}"
                 MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown" MouseEnter="UIElement_OnMouseEnter" />

        </Canvas>
    </Viewbox>
</UserControl>
