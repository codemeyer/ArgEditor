<UserControl x:Class="ArgEditor.Features.CarSet.HelmetColors.HelmetPaintingTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helmetColors="clr-namespace:ArgEditor.Features.CarSet.HelmetColors"
             xmlns:palette="clr-namespace:ArgEditor.Features.Palette"
             xmlns:main="clr-namespace:ArgEditor.Features.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="880" d:DesignHeight="590">
    <UserControl.InputBindings>
        <KeyBinding Key="OemPlus" Command="{Binding PaletteSelectNextBrighterColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
        <KeyBinding Key="OemMinus" Command="{Binding PaletteSelectNextDarkerColorCommand}" CommandParameter="{Binding Palette}"></KeyBinding>
    </UserControl.InputBindings>
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="230" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Drivers}" Margin="5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Border.Style>
                            <Style>
                                <Setter Property="Border.BorderThickness" Value="0.5" />
                                <Setter Property="Border.BorderBrush" Value="DarkGray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Helmet.IsSelected}" Value="True">
                                        <Setter Property="Border.BorderThickness" Value="0.5" />
                                        <Setter Property="Border.BorderBrush" Value="#000000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,1">
                        <helmetColors:HelmetUserControl DataContext="{Binding Helmet}"
                                                    Width="48" Margin="10,5,10,4" Height="38"
                                                    MouseLeftButtonDown="SelectHelmet_OnMouseLeftButtonDown">
                            <helmetColors:HelmetUserControl.Style>
                                <Style TargetType="{x:Type helmetColors:HelmetUserControl}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </helmetColors:HelmetUserControl.Style>
                            <helmetColors:HelmetUserControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Click="HelmetSelectionCopy_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    <MenuItem Header="Paste" Click="HelmetSelectionPaste_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    <Separator></Separator>
                                    <MenuItem Header="Load .HEL File" Click="HelmetSelectionLoadFile_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    <MenuItem Header="Save .HEL File" Click="HelmetSelectionSaveFile_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                </ContextMenu>
                            </helmetColors:HelmetUserControl.ContextMenu>
                        </helmetColors:HelmetUserControl>
                        <TextBlock Text="{Binding ShortName}" Margin="0,-2,0,1" Width="94" TextAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                    </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="1" Grid.Row="0" BorderBrush="#D4D4D4" BorderThickness="1" Margin="20,5,5,20">
        <helmetColors:HelmetUserControl Grid.Column="1" Grid.Row="0" DataContext="{Binding SelectedHelmet}"
                                        Width="260" Height="200"
                                        HorizontalAlignment="Right" Margin="0,0,15,0" VerticalAlignment="Top"
                                        IsEditable="true"
                                        ClickedHelmetPolygon="PaintHelmetUserControl_OnClickedPolygon" />
        </Border>
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="25,10,10,10"
               Content="{Binding SelectedHelmet.Parent.Name}" />
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="25,28,10,10"
               Content="{Binding SelectedHelmet.Parent.DisplayNumber}" />
        <palette:PaletteUserControl Grid.Row="0" Grid.Column="1" DataContext="{Binding Palette}"
                                         HorizontalAlignment="Right" Margin="0,220,5,0"
                                         VerticalAlignment="Top" Grid.RowSpan="2"/>
        <TextBlock Grid.Column="1" Grid.Row="0" TextWrapping="Wrap" Margin="30,80,300,0" Visibility="{Binding SelectedHelmet.ShowDecompressedExeMessage}">
            Note: Limitations apply to helmets for drivers
            with numbers #13, #15, #36, #37, #38, #39 and #40,
            unless you are using a decompressed EXE.

            <Hyperlink
                NavigateUri="http://www.argtools.com/argeditor/decompressed-exe/"
                RequestNavigate="Hyperlink_RequestNavigate">
                Learn more!
            </Hyperlink>
        </TextBlock>
        <TextBlock Grid.Column="1" Grid.Row="0" TextWrapping="Wrap" Margin="30,120,300,0" Visibility="{Binding SelectedHelmet.ShowInactiveDriverMessage}">
            Note: This helmet belongs to a driver that does not have a number assigned,
            and will not appear in the game.
        </TextBlock>
    </Grid>

</UserControl>
