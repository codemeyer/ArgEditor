<Window x:Class="ArgEditor.Features.CarSet.HelmetColors.BrowseHelmetColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helmetColors="clr-namespace:ArgEditor.Features.CarSet.HelmetColors"
        d:DataContext="{d:DesignInstance Type=helmetColors:BrowseHelmetColorsViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Browse Helmet Colors" Height="594" Width="900">
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding HelpDocsCommand}" CommandParameter="{Binding}"></KeyBinding>
    </Window.InputBindings>
    <Grid Margin="5">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="480" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal">
            <Button Width="76" Height="23" Margin="3" HorizontalAlignment="Left" Command="{Binding BrowseCommand}" CommandParameter="{Binding}">Browse...</Button>
            <TextBlock Margin="8,8,2,0" Visibility="{Binding ShowPath}">Selected file:</TextBlock>
            <TextBlock Margin="8" Visibility="{Binding ShowPath}" Text="{Binding FilePath}"></TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1">

            <ItemsControl ItemsSource="{Binding Helmets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <helmetColors:HelmetUserControl Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Width="76" Height="76"
                                                        MouseLeftButtonDown="UIElement_OnMouseLeftButtonDown">
                            <helmetColors:HelmetUserControl.Style>
                                <Style TargetType="{x:Type helmetColors:HelmetUserControl}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransformOrigin" Value="0.5, 0.5"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </helmetColors:HelmetUserControl.Style>
                        </helmetColors:HelmetUserControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button Width="76" Height="23" Margin="3" IsDefault="True" IsEnabled="{Binding CanClickOk}" Click="OKButton_Click">OK</Button>
            <Button Width="76" Height="23" Margin="3" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
