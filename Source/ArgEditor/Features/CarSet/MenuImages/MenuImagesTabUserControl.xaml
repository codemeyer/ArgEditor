<UserControl x:Class="ArgEditor.Features.CarSet.MenuImages.MenuImagesTabUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:main="clr-namespace:ArgEditor.Features.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=main:MainViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="880" d:DesignHeight="590">
    <Grid Width="880" Height="590">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="380" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ItemsControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" ItemsSource="{Binding Drivers}" Margin="5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Border.Style>
                            <Style>
                                <Setter Property="Border.BorderThickness" Value="0.5" />
                                <Setter Property="Border.BorderBrush" Value="DarkGray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MenuImage.IsSelected}" Value="True">
                                        <Setter Property="Border.BorderThickness" Value="0.5" />
                                        <Setter Property="Border.BorderBrush" Value="#000000" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                            <Image Width="48" Height="48" Margin="0" Stretch="None" Source="{Binding MenuImage.Image}"
                                   MouseLeftButtonDown="SelectMenuImage_OnMouseLeftButtonDown">
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy" Click="MenuImageSelectionCopy_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                        <MenuItem Header="Paste" Click="MenuImageSelectionPaste_Click" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Parent}"></MenuItem>
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <TextBlock FontSize="11" Text="{Binding ShortName}" Margin="1,0,1,0" Width="92" TextAlignment="Center" TextTrimming="CharacterEllipsis"></TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="25,10,10,10"
               Content="{Binding SelectedMenuImage.Parent.Name}" />
        <Label Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="25,28,10,10"
               Content="{Binding SelectedMenuImage.Parent.DisplayNumber}" />
        <Border Grid.Column="1" Grid.Row="0" BorderBrush="#D4D4D4" BorderThickness="1" Margin="20,5,5,160">
            <StackPanel Height="220" VerticalAlignment="Top">
                <StackPanel Margin="170,0,0,0" Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <Image VerticalAlignment="Top" Margin="0,5,5,5" Width="48" Height="48" Source="{Binding SelectedMenuImage.Image}"></Image>
                        <TextBlock>1x</TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Bottom" Margin="-16,0,0,5">4x</TextBlock>
                        <Image VerticalAlignment="Top" Margin="10,5,5,5"  Width="192" Height="192" Source="{Binding SelectedMenuImage.MagnifiedImage}"></Image>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="15,250,0,0">
            <Button Width="105" Height="24" Margin="5,0,0,0" Command="{Binding LoadMenuImageCommand}" CommandParameter="{Binding SelectedMenuImage}">
                Load from File...
            </Button>
            <!--<Button Width="105" Height="24" Margin="5,0,0,0" Command="{Binding SelectedMenuImageFromDatCommand}" CommandParameter="{Binding SelectedMenuImage}">
                Select from DAT...
            </Button>-->
            <Button Width="105" Height="24" Margin="5,0,0,0" Command="{Binding SaveMenuImageToFileCommand}" CommandParameter="{Binding SelectedMenuImage}">
                Save to File
            </Button>
            <Button Width="105" Height="24" Margin="5,0,0,0" Command="{Binding ClearMenuImageCommand}" CommandParameter="{Binding SelectedMenuImage}">
                Clear
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
