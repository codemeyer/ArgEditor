<Window x:Class="ArgEditor.Features.CarSet.MenuImages.MenuImageImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:menuImages="clr-namespace:ArgEditor.Features.CarSet.MenuImages"
        d:DataContext="{d:DesignInstance Type=menuImages:LoadMenuImageViewModel, IsDesignTimeCreatable=True}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Load Menu Image" Height="348" Width="574">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="240" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Button Width="76" Height="23" Margin="3" HorizontalAlignment="Left" IsEnabled="{Binding CanExport}" Click="BrowseButton_Click">Browse...</Button>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="1">
            <GroupBox Header="Original" Margin="5,0,5,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <Image VerticalAlignment="Top" Margin="0,5,5,5" Width="48" Height="48" Source="{Binding OriginalImage}"></Image>
                        <TextBlock>1x</TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Bottom" Margin="-16,0,0,5">4x</TextBlock>
                        <Image VerticalAlignment="Top" Margin="10,5,5,5"  Width="192" Height="192" Source="{Binding OriginalMagnifiedImage}"></Image>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="1" Margin="5,0,5,5">
            <GroupBox Header="In-Game">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                    <StackPanel Orientation="Vertical">
                        <Image VerticalAlignment="Top" Margin="0,5,5,5" Width="48" Height="48" Source="{Binding InGameImage}"></Image>
                        <TextBlock>1x</TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Bottom" Margin="-16,0,0,5">4x</TextBlock>
                        <Image VerticalAlignment="Top" Margin="10,5,5,5"  Width="192" Height="192" Source="{Binding InGameMagnifiedImage}"></Image>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button Width="76" Height="23" Margin="3" IsDefault="True" Click="OKButton_Click">OK</Button>
            <Button Width="76" Height="23" Margin="3" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
