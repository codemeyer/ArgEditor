<UserControl x:Class="ArgEditor.Features.CarSet.DriverPerformance.TeamDriverPerformanceUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:carSet="clr-namespace:ArgEditor.Features.CarSet"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=carSet:DesignerTeamViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="31" d:DesignWidth="610">
    <Grid Margin="2,3,2,4">
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="0,-2" Width="118" Content="{Binding Name}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" Height="20" Margin="117,0,0,0" Width="38" MaxLength="4" Text="{Binding Horsepower, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Visibility}"
                 KeyDown="UIElement_OnKeyDown" GotFocus="Team_GotFocus" LostFocus="Team_LostFocus"></TextBox>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="192,-2,0,-2" Width="130" Content="{Binding Drivers[0].ShortName}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Margin="311,0,0,0" Width="32" Text="{Binding Drivers[0].QualifyingGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[0].Visibility}"
                 KeyDown="UIElement_OnKeyDown" GotFocus="Driver1SkillQ_GotFocus" LostFocus="DriverSkill_LostFocus"></TextBox>
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Margin="348,0,0,0" Width="32" Text="{Binding Drivers[0].RaceGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[0].Visibility}"
                 KeyDown="UIElement_OnKeyDown" GotFocus="Driver1SkillR_GotFocus" LostFocus="DriverSkill_LostFocus"></TextBox>
        <Label HorizontalAlignment="Left" VerticalAlignment="Top" Height="27" Margin="401,-2,0,-2" Width="130" Content="{Binding Drivers[1].ShortName}" />
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Margin="518,0,0,0" Width="32" Text="{Binding Drivers[1].QualifyingGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[1].Visibility}"
                 KeyDown="UIElement_OnKeyDown" GotFocus="Driver2SkillQ_GotFocus" LostFocus="DriverSkill_LostFocus"></TextBox>
        <TextBox HorizontalAlignment="Left" VerticalAlignment="Top" Height="20" Margin="555,0,0,0" Width="32" Text="{Binding Drivers[1].RaceGripLevel, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Drivers[1].Visibility}"
                 KeyDown="UIElement_OnKeyDown" GotFocus="Driver2SkillR_GotFocus" LostFocus="DriverSkill_LostFocus"></TextBox>
    </Grid>
</UserControl>
