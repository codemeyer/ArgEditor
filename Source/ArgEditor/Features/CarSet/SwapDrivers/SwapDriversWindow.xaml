<Window x:Class="ArgEditor.Features.CarSet.SwapDrivers.SwapDriversWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArgEditor.Features.CarSet.SwapDrivers"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Title="Swap Drivers" Height="280" Width="280">
    <Grid>

        <StackPanel Orientation="Vertical">
            <Label Margin="4,0">Select drivers to swap</Label>
            <ComboBox Margin="8" SelectedItem="{Binding SelectedDriver1}" ItemsSource="{Binding AvailableDrivers}" DisplayMemberPath="LongDescription" />
            <ComboBox Margin="8" SelectedItem="{Binding SelectedDriver2}" ItemsSource="{Binding AvailableDrivers}" DisplayMemberPath="LongDescription" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Width="76" Height="23" Margin="3" IsDefault="True" IsEnabled="{Binding CanClickOk}" Click="OKButton_Click">OK</Button>
            <Button Width="76" Height="23" Margin="3" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
