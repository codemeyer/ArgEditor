<UserControl x:Class="ArgEditor.Features.GameSettings.PlayerHorsepowerUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="440">
    <Grid>
        <GroupBox Header="Human Car Level of Performance">
            <StackPanel Orientation="Horizontal">
                <Label VerticalAlignment="Top" Width="160" HorizontalAlignment="Left">Player Horsepower</Label>
                <Slider Minimum="400" Maximum="1460" Value="{Binding PlayerHorsepower}"
                        Margin="10,3,10,0" Width="100"></Slider>
                <TextBox VerticalAlignment="Top" Margin="5,3,35,0" Width="40" Height="20" Text="{Binding PlayerHorsepower, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                <Button VerticalAlignment="Top" Margin="5,3,5,5" Width="50" Height="20"  Click="SetDefaultHorsepower_OnClick">Reset</Button>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
